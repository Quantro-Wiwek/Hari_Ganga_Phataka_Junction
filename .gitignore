# See https://github.com/github/gitignore/blob/main/Node.gitignore

# Dependencies
node_modules/

# Production build
/dist/
/build/

# Vite cache
/.vite/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS metadata
.DS_Store
Thumbs.db

# Tests and coverage
coverage/
.nyc_output/

# Env files
.env
.env.*
!.env.example

# Misc
*.pid
*.seed
*.swp
*.swo

# Framework/platform
.vercel/
.netlify/
.turbo/
